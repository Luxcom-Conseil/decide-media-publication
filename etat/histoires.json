     "type": "recit",
     "ecran": "La *recette* du parfait faussaire",
     "grand": null,
     "dit": "Il achète de vieilles toiles du XVIIe siècle, gratte la peinture et fabrique ses propres pigments d'époque.",
     "image": 7,
     "recherche": null
    },
    {
     "type": "recit",
     "ecran": "Une *cuisson* pour vieillir la peinture",
     "grand": null,
     "dit": "Il passe même ses toiles au four et ajoute de l'encre noire dans les craquelures pour imiter la poussière du temps.",
     "image": 6,
     "recherche": "vintage oven 1930s"
    },
    {
