     "recherche": null
    },
    {
     "type": "recit",
     "ecran": "Un *talent* rejeté par les critiques",
     "grand": null,
     "dit": "Au début du XXe siècle, aux Pays-Bas, Han van Meegeren veut devenir un grand artiste.",
     "image": 6,
     "recherche": null
    },
    {
     "type": "recit",
     "ecran": "Ses œuvres jugées comme de simples *imitations*",
     "grand": null,
     "dit": "Mais en 1922, les critiques d'art démolissent son travail. Ils disent que ses toiles ne sont que de vieilles imitations.",
     "image": 5,
     "recherche": null
    },
    {
     "type": "recit",
     "ecran": "La *vengeance* d'un peintre humilié",
     "grand": null,
     "dit": "Blessé, Han décide de se venger. Il va prouver au monde entier qu'il est capable de duper tous les experts.",
     "image": 11,
     "recherche": "Han van Meegeren portrait"
    },
    {
     "type": "chiffre",
     "ecran": "Ans de préparation secrète",
