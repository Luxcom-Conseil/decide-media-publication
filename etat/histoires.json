     "image": 6,
     "recherche": null
    },
    {
     "type": "date",
     "ecran": "1812",
     "grand": "1812",
     "dit": "En 1812, après la mort de sa femme, il s'embarque pour l'Amérique du Sud pour participer aux révoltes contre l'Espagne.",
